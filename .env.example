# Server
PORT=8000

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Optional: non-SRV connection string, used first when set (helps on networks that block SRV DNS)
MONGODB_URI_STANDARD=

# Comma-separated list of frontend origins allowed by CORS
CLIENT_URL=http://localhost:3000

# Firebase Admin (Firebase console -> Project settings -> Service accounts)
# FIREBASE_PROJECT_ID alone is enough to verify ID tokens; the service account pair is optional.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the literal \n sequences from the downloaded JSON key
FIREBASE_PRIVATE_KEY=
